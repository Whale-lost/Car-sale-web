    <footer class="footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-logo">
                    <h3>VanCar</h3>
                    <p style="margin-top: 12px;">Clean pre-owned cars.<br>For tomorrow's drive.</p>
                </div>
                <div class="footer-links">
                    <div class="footer-col">
                        <strong>Explore</strong>
                        <a href="#">Home</a>
                        <a href="#" id="footerSeller">Sellers Hub</a>
                        <a href="#" id="footerSearch">Search Cars</a>
                    </div>
                    <div class="footer-col">
                        <strong>Support</strong>
                        <a href="#">FAQ</a>
                        <a href="#">Warranty</a>
                        <a href="#">Contact</a>
                    </div>
                </div>
            </div>
            <div class="copyright">
                © 2025 VanCar — Sustainable pre-owned electric & hybrid vehicles. All rights reserved.
            </div>
        </div>
    </footer>

    <script>
        const cursor = document.getElementById('cursorFollower');
        if(cursor){
            let mouseX = 0, mouseY = 0;
            let cursorX = 0, cursorY = 0;

            document.addEventListener('mousemove', e => {
                mouseX = e.clientX;
                mouseY = e.clientY;
            });

            function animateCursor(){
                cursorX += (mouseX - cursorX) * 0.2;
                cursorY += (mouseY - cursorY) * 0.2;
                cursor.style.left = cursorX + 'px';
                cursor.style.top = cursorY + 'px';
                requestAnimationFrame(animateCursor);
            }
            animateCursor();

            const interactive = document.querySelectorAll('a, button, .car-card, .btn, .nav-link');
            interactive.forEach(el => {
                el.onmouseenter = () => {
                    cursor.style.transform = 'translate(-50%, -50%) scale(1.35)';
                    cursor.style.background = 'radial-gradient(circle, rgba(169,198,255,0.6) 0%, rgba(197,217,255,0.35) 70%)';
                    cursor.style.backdropFilter = 'blur(4px)';
                };
                el.onmouseleave = () => {
                    cursor.style.transform = 'translate(-50%, -50%) scale(1)';
                    cursor.style.background = 'radial-gradient(circle, rgba(169,198,255,0.45) 0%, rgba(197,217,255,0.25) 60%, rgba(169,198,255,0) 90%)';
                    cursor.style.backdropFilter = 'blur(2px)';
                };
            });
        }

        const sellerBtns = document.querySelectorAll('#sellerLink,#heroSellerBtn,#sellerDirectBtn,#footerSeller');
        const searchBtns = document.querySelectorAll('#searchLink,#heroSearchBtn,#searchDirectBtn,#footerSearch');
        const cardDetailBtns = document.querySelectorAll('.card-link');

        sellerBtns.forEach(btn => btn.addEventListener('click', e => e.preventDefault()));
        searchBtns.forEach(btn => btn.addEventListener('click', e => e.preventDefault()));
        cardDetailBtns.forEach(btn => btn.addEventListener('click', e => e.preventDefault()));

        let lightShift = 0;
        function moveBgGlow(){
            lightShift += 0.003;
            let x = 35 + Math.sin(lightShift) * 12;
            let y = 45 + Math.cos(lightShift * 0.7) * 15;
            document.body.style.background = `radial-gradient(circle at ${x}% ${y}%, #eef5ff, #e1edff, #d6e5ff)`;
            requestAnimationFrame(moveBgGlow);
        }
        moveBgGlow();
    </script>
</body>
</html>
